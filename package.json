{
  "name": "optilint",
  "version": "0.0.1",
  "description": "A linter that finds and fixes JavaScript/TypeScript performance problems",
  "type": "module",
  "private": true,
  "bin": {
    "optilint": "./src/cli.ts"
  },
  "license": "MIT",
  "scripts": {
    "bench": "bun bench/run.ts",
    "bench:speedups": "bun bench/speedups.ts && bun bench/chart.ts",
    "bundle": "bun scripts/bundle.ts",
    "lint:self": "bun src/cli.ts src",
    "schema": "bun src/cli.ts --print-schema config > schema.json && bun src/cli.ts --print-schema output > output.schema.json",
    "test": "bun test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24",
    "mitata": "1.0.34"
  }
}
